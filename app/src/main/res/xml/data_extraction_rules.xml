<?xml version="1.0" encoding="utf-8"?>
<!--
   Android Auto Backup and device transfer (Android 12 and higher): history database,
   alerts and settings. See https://developer.android.com/about/versions/12/backup-restore
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="apple_stock_pulse_prefs.xml" />
        <include domain="sharedpref" path="apple_stock_pulse_rules.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="apple_stock_pulse_prefs.xml" />
        <include domain="sharedpref" path="apple_stock_pulse_rules.xml" />
    </device-transfer>
</data-extraction-rules>
